# Source this (set -a; source benchmarks/.env.bench; set +a) before starting the API.
# All values are bench-only dummies.
DATABASE_URL=postgresql://bench:bench@localhost:5433/upsprint_bench
JWT_SECRET=bench-secret
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=bench
GOOGLE_CLIENT_SECRET=bench
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
FRONTEND_URL=http://localhost:3000
NODE_ENV=production
ADMIN_EMAILS=admin@bench.local
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000

# Bench hooks (see METHODOLOGY.md)
DISABLE_CRON=true
LEETCODE_BASE_URL=http://localhost:4100
CODEFORCES_BASE_URL=http://localhost:4100
CODECHEF_BASE_URL=http://localhost:4100

# Mock platform server
MOCK_PORT=4100
MOCK_LATENCY_MS=0
MOCK_JITTER_MS=0
MOCK_ERROR_RATE=0
