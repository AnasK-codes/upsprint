# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (Prisma + pg)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/upsprint

# Secret used to sign JWTs. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Frontend origin (CORS and OAuth redirects)
FRONTEND_URL=http://localhost:3000
# Required by src/env.ts at startup
NEXT_PUBLIC_API_URL=http://localhost:4000

NODE_ENV=development
# Comma-separated emails allowed to use admin endpoints
ADMIN_EMAILS=you@example.com

# Optional
# Bearer token required for GET /metrics. If unset, /metrics is disabled (404).
METRICS_TOKEN=
# Cookie settings. Defaults: SameSite=None; Secure in production, Lax in development.
# Same-site deployment (app.example.com + api.example.com): COOKIE_SAMESITE=lax, COOKIE_DOMAIN=.example.com
COOKIE_SAMESITE=
COOKIE_DOMAIN=
PORT=4000
LOG_LEVEL=info

# --- Queues / worker (Step 2.2). REDIS_URL is required by the worker. ---
REDIS_URL=redis://localhost:6379
# Hours between full syncs, and max random spread (seconds) of jobs inside a sync
SYNC_INTERVAL_HOURS=6
SYNC_JITTER_SECONDS=300
# Daily leaderboard rebuild (cron, UTC)
LEADERBOARD_CRON=0 1 * * *
# Per platform (LEETCODE | CODEFORCES | CODECHEF): parallel jobs, and limiter "max jobs per duration"
# SYNC_CONCURRENCY_LEETCODE=3
# RATE_LIMIT_LEETCODE_MAX=5
# RATE_LIMIT_LEETCODE_DURATION_MS=1000
# Retries: attempts and exponential backoff (with jitter) bounds
SYNC_ATTEMPTS=5
SYNC_BACKOFF_BASE_MS=5000
SYNC_BACKOFF_MAX_MS=300000
# Max handles per Codeforces user.info call
CODEFORCES_BATCH_SIZE=50
# Circuit breaker per platform: window, minimum samples, failure ratio, cooldown
BREAKER_WINDOW=20
BREAKER_MIN_SAMPLES=10
BREAKER_FAILURE_THRESHOLD=0.5
BREAKER_COOLDOWN_MS=60000
# Worker liveness port
WORKER_HEALTH_PORT=4001
