# Used by docker compose (copy to .env). Never commit .env.

# Required: signs JWTs. Generate with `openssl rand -hex 32`.
JWT_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials). Login needs real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

FRONTEND_URL=http://localhost:3000
# Baked into the web image at build time; rebuild web after changing it.
NEXT_PUBLIC_API_URL=http://localhost:4000
ADMIN_EMAILS=you@example.com

# Optional
POSTGRES_USER=upsprint
POSTGRES_PASSWORD=upsprint
POSTGRES_DB=upsprint
METRICS_TOKEN=
